# ---------------------------------------------------------------------------
# Agent Mobile — environment variables
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM provider (required) ----------------------------------------------
# Any OpenAI-compatible endpoint works: OpenAI, OpenRouter, Groq, Together, vLLM...
OPENAI_API_KEY=sk-...
# Optional: point at a different OpenAI-compatible gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Tools (optional — each tool degrades gracefully when unset) -----------
# Web search tool (https://tavily.com)
TAVILY_API_KEY=tvly-...

# Current-weather tool (https://openweathermap.org/api). Free tier is enough.
OPENWEATHER_API_KEY=your-openweather-api-key

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "1" to allow the run_code tool to execute untrusted code.
# Disabled by default because it runs in the app's own process sandbox.
ENABLE_CODE_EXECUTION=0

# Canonical URL the packaged Android app should load. Read by
# capacitor.config.ts, and injected into the web bundle so the native shell can
# tell whether this build was configured.
NEXT_PUBLIC_APP_URL=https://agent-mobile.vercel.app

# ---------------------------------------------------------------------------
# Android release signing (NOT needed for web development)
# ---------------------------------------------------------------------------
# Read by `android/app/build.gradle` at build time. Supply them as real
# environment variables or CI secrets — never commit them. When they are unset,
# the release variant is built unsigned instead of the build failing.
#
# ANDROID_KEYSTORE_PATH=/absolute/path/to/release.keystore
# ANDROID_KEYSTORE_PASSWORD=...
# ANDROID_KEY_ALIAS=agent-mobile
# ANDROID_KEY_PASSWORD=...
#
# URL baked into the APK. Overrides NEXT_PUBLIC_APP_URL for packaged builds.
# APP_URL=https://agent-mobile.vercel.app
